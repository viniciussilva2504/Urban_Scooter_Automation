                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"login\": \"vinitst\", \"password\": \"1234\", \"firstName\": \"Vinic\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/courier",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "courier"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "}});",
                  "",
                  "pm.test('Body contains True', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('ok', True);",
                  "}});"
                ]
              }
            }
          ]
        },
